# ==========================================
# EMSPro Environment Configuration Template
# ==========================================

# Security
# Set a strong, unique secret key for production
SECRET_KEY=your-secret-key-here-change-in-production

# Debug Mode: Set to False in production
DEBUG=True

# Hostnames & Origins
# Comma-separated list of allowed hostnames (e.g. localhost,127.0.0.1,.onrender.com)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Comma-separated list of trusted origins for CSRF (e.g. https://your-app.onrender.com)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
# Option 1: Standard Individual Credentials (used for local PostgreSQL)
DB_ENGINE=postgresql
DB_NAME=EMSproject
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Option 2: Full Database URL (typically provided by cloud hosts like Render)
# If DATABASE_URL is set, it overrides the individual DB_* settings above.
# DATABASE_URL=postgresql://user:password@host:port/dbname
